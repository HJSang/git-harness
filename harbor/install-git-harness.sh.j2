#!/usr/bin/env bash
set -euo pipefail

# Install git if missing (with Debian archive fallback for older bullseye images)
if ! command -v git >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    (apt-get update -qq && apt-get install -y -qq git ca-certificates >/dev/null) || \
    (sed -i 's|deb.debian.org/debian-security|archive.debian.org/debian-security|g; s|deb.debian.org/debian|archive.debian.org/debian|g' /etc/apt/sources.list 2>/dev/null || true; apt-get update -qq -o Acquire::Check-Valid-Until=false && apt-get install -y -qq git ca-certificates >/dev/null)
  elif command -v apk >/dev/null 2>&1; then
    apk add --no-cache git ca-certificates >/dev/null
  fi
fi

# Install Node 24 .tar.gz directly inside container (fast DC network, zero host upload, no xz-utils!)
need_node=1
if command -v node >/dev/null 2>&1; then
  ver=$(node -v | sed 's/^v//')
  major=${ver%%.*}
  if [ "${major:-0}" -ge 24 ]; then
    need_node=0
  fi
fi

if [ "$need_node" -eq 1 ]; then
  arch=$(uname -m)
  case "$arch" in
    x86_64) node_arch="x64" ;;
    aarch64|arm64) node_arch="arm64" ;;
    *) echo "Unsupported arch: $arch" >&2; exit 1 ;;
  esac
  URL="https://nodejs.org/dist/v24.13.0/node-v24.13.0-linux-${node_arch}.tar.gz"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$URL" -o /tmp/node24.tar.gz
  elif command -v wget >/dev/null 2>&1; then
    wget -qO /tmp/node24.tar.gz "$URL"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c "import urllib.request; urllib.request.urlretrieve('$URL', '/tmp/node24.tar.gz')"
  else
    (apt-get update -qq && apt-get install -y -qq curl ca-certificates >/dev/null) || \
    (sed -i 's|deb.debian.org/debian-security|archive.debian.org/debian-security|g; s|deb.debian.org/debian|archive.debian.org/debian|g' /etc/apt/sources.list 2>/dev/null || true; apt-get update -qq -o Acquire::Check-Valid-Until=false && apt-get install -y -qq curl ca-certificates >/dev/null)
    curl -fsSL "$URL" -o /tmp/node24.tar.gz
  fi
  mkdir -p /opt/node24
  tar -xzf /tmp/node24.tar.gz -C /opt/node24 --strip-components=1
  rm -f /tmp/node24.tar.gz
  ln -sf /opt/node24/bin/node /usr/local/bin/node
  ln -sf /opt/node24/bin/npm /usr/local/bin/npm
fi

mkdir -p /installed-agent/git-harness
if [ -f /installed-agent/git-harness.tar.gz ]; then
  tar -xzf /installed-agent/git-harness.tar.gz -C /installed-agent/git-harness
fi

node -v
git --version
